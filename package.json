{
  "name": "maquetamina",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de control de maquinaria minera.",
  "author": "Estefany Torres <estefanyt3101@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/fix-electron-ext.mjs",
    "predev": "npm run build:electron",
    "prebuild": "npm run build:electron",
    "prebuild:web": "npm run build:electron",
    "prebuild:win": "npm run build",
    "prebuild:linux": "npm run build",
    "prepreview": "npm run build:electron",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:6969/login && electron . --no-sandbox\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:web": "npm run build",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "rimraf dist releases electron/main.js electron/main.cjs electron/preload.js electron/preload.cjs"
  },
  "build": {
    "appId": "com.perucontrols.maquetamina",
    "productName": "Sistema de maquinaria minera",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/logopcs.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/logopcs.png"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "uninstallDisplayName": "MineriaSystems",
      "license": "",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "releases",
      "buildResources": "dist"
    }
  },
  "dependencies": {
    "@iconify-react/mingcute": "^1.0.3",
    "@iconify/css-react": "^1.0.2",
    "flat-color-icons": "^1.1.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "9.2.1",
    "electron": "39.0.0",
    "electron-builder": "26.0.12",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.1.12",
    "wait-on": "9.0.1"
  },
  "keywords": []
}
